# Normalizacija line endinga
* text=auto

# Unity YAML fajlovi — tekst, korisni diffovi
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.meta text eol=lf
*.mat text eol=lf
*.cs text diff=csharp

# ── Git LFS: binarni asseti i trenirani modeli ──
# (git lfs install obavezno prije prvog commita ovih tipova)
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
# GIF snimci vožnje su desetine megabajta po fajlu, a playback animacija iz
# feature 004 je 8.9 MB. Bez ovog pravila ulaze u historiju kao obični blobovi i
# tamo ostaju zauvijek; poslije se vade samo rewriteom.
#
# Pravilo su feature 003 i feature 004 dodali nezavisno jedan od drugog, pa se
# pri mergeu pojavilo dva puta. Ostavljen je jedan red.
#
# UPOZORENJE: docs/images/human-driving.gif (63 MB) i docs/images/track.gif
# (15 MB) su commitovani PRIJE nego je ovo pravilo postojalo, pa su u historiji
# kao sirovi blobovi. Pravilo ih ne vadi unazad.
*.gif filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.psd filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.onnx filter=lfs diff=lfs merge=lfs -text
*.pt filter=lfs diff=lfs merge=lfs -text
*.pth filter=lfs diff=lfs merge=lfs -text
*.h5 filter=lfs diff=lfs merge=lfs -text
