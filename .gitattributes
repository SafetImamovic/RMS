# Normalizacija line endinga
* text=auto

# ── Generisani fajlovi: sakriti iz pregleda diffa ──
# Ovi fajlovi se NE pišu rukom. Pravi ih python -m python.track.export, odnosno
# python.bc.split, i determinističke su funkcije seeda. Committuju se namjerno, da
# Unity može učitati stazu bez pokretanja Pythona (feature 003).
#
# Problem je bio pregled na GitHubu, ne veličina na disku. Svaka staza ima 2000 tačaka
# centralne linije ispisanih sa indent=2, što je 14.318 linija po fajlu i 629.992 linija
# na 44 fajla. Uz split.json to je 86 posto diffa develop..master, pa pull request nije
# bio čitljiv niti se htio otvoriti.
#
# linguist-generated skuplja ih u pregledu i izbacuje iz statistike jezika. Sadržaj
# ostaje u historiji nepromijenjen i git diff lokalno i dalje radi.
unity/SelfDrivingSim/Assets/Tracks/seed_*.json linguist-generated=true
results/bc/split.json linguist-generated=true
results/drive_logs/*.csv linguist-generated=true

# Unity YAML fajlovi — tekst, korisni diffovi
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.meta text eol=lf
*.mat text eol=lf
*.cs text diff=csharp

# ── Git LFS: binarni asseti i trenirani modeli ──
# (git lfs install obavezno prije prvog commita ovih tipova)
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
# GIF snimci vožnje su desetine megabajta po fajlu, a playback animacija iz
# feature 004 je 8.9 MB. Bez ovog pravila ulaze u historiju kao obični blobovi i
# tamo ostaju zauvijek; poslije se vade samo rewriteom.
#
# Pravilo su feature 003 i feature 004 dodali nezavisno jedan od drugog, pa se
# pri mergeu pojavilo dva puta. Ostavljen je jedan red.
#
# UPOZORENJE: docs/images/human-driving.gif (63 MB) i docs/images/track.gif
# (15 MB) su commitovani PRIJE nego je ovo pravilo postojalo, pa su u historiji
# kao sirovi blobovi. Pravilo ih ne vadi unazad.
*.gif filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.psd filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.onnx filter=lfs diff=lfs merge=lfs -text
*.pt filter=lfs diff=lfs merge=lfs -text
*.pth filter=lfs diff=lfs merge=lfs -text
*.h5 filter=lfs diff=lfs merge=lfs -text
